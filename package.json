{
  "name": "dev-ai-toolkit",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first prompt workflows with supporting JSON, API request, and code review utilities.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=moderate",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "ai",
    "developer-tools",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Chenzhaowen",
  "license": "MIT",
  "homepage": "https://github.com/as569951728/dev-ai-toolkit",
  "bugs": {
    "url": "https://github.com/as569951728/dev-ai-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/as569951728/dev-ai-toolkit.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  }
}
